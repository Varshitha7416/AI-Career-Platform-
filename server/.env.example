MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
PORT=5000
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
GEMINI_API_KEY=your-gemini-key
# Optional
GEMINI_MODEL=gemini-3.6-flash

# --- Backup AI provider (docs/32). Gemini stays primary; Groq (FREE tier only) is an optional fallback. ---
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
# Leave GROQ_API_KEY empty to keep the fallback off. Even with a key, NOTHING is sent to Groq until GROQ_PRIVACY_ACK=true,
# which you set only after reviewing Groq's data terms and publishing the Privacy Policy update (docs/32).
GROQ_API_KEY=
GROQ_PRIVACY_ACK=false
# Provisional: confirm availability and free-tier limits in your own Groq console (Settings > Limits) before relying on it.
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_MS=30000
# Largest prompt (characters, instructions included) that may be sent to Groq; bigger requests skip the backup. The default is
# 12000, which fits realistic job-specific analyses, cover letters and skill gap requests. Groq's free plan has a small per-minute
# token budget (about 8,000 tokens documented), so very large requests can still be refused by Groq.
GROQ_MAX_INPUT_CHARS=12000
# AI_BREAKER_FAILURES=3
# AI_BREAKER_COOLDOWN_MS=60000
CLIENT_ORIGIN=http://localhost:5173
# Admin access is NOT configured here. ADMIN_EMAIL auto-promotion was removed; create the first admin with `npm run bootstrap:admin` (docs/23).
# Index building: ON for a local MongoDB, OFF for Atlas/remote (use `npm run indexes`). Override with true/false.
# AUTO_INDEX=false
# Auth hardening (all optional)
# JWT_SECRET should be a random string of 32+ characters. A weak/placeholder secret only warns in development and
# stops the server when NODE_ENV=production. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Number of reverse-proxy hops in front of the API. Leave unset when clients connect directly (login/signup rate
# limits are per client IP, and in-memory: they reset on restart and are not shared between instances).
# TRUST_PROXY=1
# Email (password reset). Development uses a LOCAL OUTBOX: emails are stored in MongoDB, never sent. It exists ONLY when NODE_ENV is
# exactly "development" or "test" (unset, "Production", "prod" etc. get no outbox and forgot-password answers 503). The outbox
# VIEWER is opt-in (DEV_OUTBOX_ENABLED=true); the server prints a per-process key at start-up, send it as the X-Dev-Outbox-Key header:
#   curl -H "X-Dev-Outbox-Key: <key>" "http://localhost:5000/api/dev/outbox?to=<email>"
# No real provider is configured yet.
# NODE_ENV=development
# EMAIL_TRANSPORT=outbox
# EMAIL_FROM=CareerNest <no-reply@careernest.local>
# APP_BASE_URL=http://localhost:5173
# RESET_TOKEN_TTL_MINUTES=30
# DEV_OUTBOX_ENABLED=true
# Password reset limits. Per IP (in memory, per process; defaults shown): AUTH_FORGOT_IP_MAX=10  AUTH_FORGOT_WINDOW_MINUTES=60  AUTH_RESET_MAX=10
# Per account (in the database, shared by all processes, silent): RESET_COOLDOWN_SECONDS=60 (30..3600)  RESET_MAX_PER_HOUR=5 (1..20)
# Email verification (docs/23): link lifetime VERIFY_TOKEN_TTL_HOURS=24 (1..168). Per account, in the database: VERIFY_COOLDOWN_SECONDS=60 (30..3600)  VERIFY_MAX_PER_HOUR=5 (1..20). Per IP (in memory): AUTH_VERIFY_MAX=20  AUTH_VERIFY_REQUEST_IP_MAX=10
# First-admin bootstrap (CLI only, never set these in the app's runtime env): BOOTSTRAP_ADMIN_SECRET (24+ random chars, one-time), BOOTSTRAP_ALLOW_REMOTE_DB=<exact db name>, BOOTSTRAP_ALLOW_PRODUCTION=true
# There is deliberately no per-email 429 (it would let a third party lock the owner out of recovery).
