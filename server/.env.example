MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
PORT=5000
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
GEMINI_API_KEY=your-gemini-key
# Optional
GEMINI_MODEL=gemini-3.6-flash
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=you@example.com
# Index building: ON for a local MongoDB, OFF for Atlas/remote (use `npm run indexes`). Override with true/false.
# AUTO_INDEX=false
# Auth hardening (all optional)
# JWT_SECRET should be a random string of 32+ characters. A weak/placeholder secret only warns in development and
# stops the server when NODE_ENV=production. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Number of reverse-proxy hops in front of the API. Leave unset when clients connect directly (login/signup rate
# limits are per client IP, and in-memory: they reset on restart and are not shared between instances).
# TRUST_PROXY=1
